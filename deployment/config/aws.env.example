# Copy to aws.env and fill values.
SSH_KEY_PATH=~/.ssh/your-key.pem
EC2_USER=ubuntu

RABBITMQ_HOST=10.0.1.10
POSTGRES_HOST=10.0.1.11
SERVER_HOST=10.0.1.12

# Comma-separated lists are supported for scaled load testing.
CONSUMER_HOSTS=10.0.1.13,10.0.1.14,10.0.1.15
CLIENT_HOSTS=10.0.1.16,10.0.1.17

SERVER_ID=server-1
HEALTH_PORT=8080

RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=adminpassword

DB_NAME=chatflow
DB_USERNAME=chatflow
DB_PASSWORD=chatflow

CONSUMER_THREADS=20
BROADCAST_BASE_URL=http://10.0.1.12:8082
SERVER_URL_FOR_CLIENT=ws://10.0.1.12:8081
