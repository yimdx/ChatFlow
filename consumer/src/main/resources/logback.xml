<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with async processing for performance -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="CONSOLE" />
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for persistent logs (async for performance) -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE" />
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/consumer.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/consumer.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set default log level to WARN for high performance -->
    <!-- Only warnings and errors will be logged, not every message -->
    <root level="WARN">
        <appender-ref ref="ASYNC_CONSOLE" />
        <appender-ref ref="ASYNC_FILE" />
    </root>

    <!-- Your application logs at INFO level for startup/shutdown events -->
    <logger name="cs6650.assignment1.consumer.Main" level="INFO" />
    
    <!-- Keep RabbitMQ connection logs at INFO -->
    <logger name="cs6650.assignment1.consumer.queue.RabbitMQConnection" level="INFO" />
    
    <!-- MessageConsumerThread at WARN means no per-message logs unless there's a problem -->
    <logger name="cs6650.assignment1.consumer.MessageConsumerThread" level="WARN" />
</configuration>
